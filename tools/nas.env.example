# Copy to tools/nas.env (git-ignored) and fill in with your own values.
# tools/nas_ssh.py and deploy/deploy.py read this file.
#
# The remote host is whatever machine runs the DGX Chat container: a NAS, a
# home server, a VPS. Nothing here is ever committed.

# Hostname or IP of the deployment machine (required).
NAS_HOST=your-server.local

# SSH user (required). It must be able to run docker, or have sudo.
NAS_USER=your-user

# SSH password (required unless NAS_KEY_FILE is set).
NAS_PASS=your-password

# Alternative: use a private key instead of a password.
# NAS_KEY_FILE=~/.ssh/id_ed25519

# SSH port (default 22).
# NAS_PORT=22

# 1 = wrap remote commands in `sudo -S` (default). Use 0 when the user is root
# or already has passwordless sudo.
# NAS_SUDO=1
