# =============================================================================
# deploy/.env.deploy.example
#
# Copy this file to deploy/.env.deploy (git-ignored) and fill in YOUR values.
# `python deploy/deploy.py sync` uploads this as the container's .env, and every
# key can also be supplied as a real environment variable (which wins).
#
# Never commit deploy/.env.deploy.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Upstream inference endpoint (OpenAI-compatible).
#    This is where chat answers are generated. It can be a local gateway
#    (vLLM / llama.cpp / Ollama / LiteLLM) or any OpenAI-compatible SaaS.
# ---------------------------------------------------------------------------
DGX_BASE_URL=http://localhost:8041/v1
# Empty is correct for an unauthenticated LAN gateway; set it for a SaaS.
DGX_API_KEY=
# Client model id -> upstream model id (JSON). The web/Android client only ever
# asks for the two ids on the left.
DGX_MODEL_MAP={"deepseek-flash":"your-upstream-model","deepseek-v4-pro":"your-upstream-model"}
DGX_TIMEOUT=300
DGX_MAX_TOKENS=8192
# How to disable reasoning on this upstream:
#   reasoning_effort | thinking | both | enable_thinking | chat_template_kwargs | none
DGX_THINKING_DISABLE_MODE=reasoning_effort
# 1 = log every upstream request body (verbose, for debugging only).
DGX_LOG_UPSTREAM=0

# ---------------------------------------------------------------------------
# 2. Optional fallback endpoint, used when the primary fails.
#    Leave both lines empty/absent if you only have one endpoint. Up to 4 can be
#    configured: DGX_BASE_URL_FALLBACK[_2..3] + DGX_API_KEY_FALLBACK[_2..3].
# ---------------------------------------------------------------------------
DGX_BASE_URL_FALLBACK=
DGX_API_KEY_FALLBACK=

# ---------------------------------------------------------------------------
# 3. Accounts
# ---------------------------------------------------------------------------
# invite (default: admin-issued invite codes) | closed | open
# The very first registration always succeeds and becomes the admin.
REGISTRATION_MODE=invite
# A single shared invite code. Leave empty to use per-user codes from /admin.
DGXCHAT_INVITE_CODE=
# 0 = tokens never expire (revoke them from /admin instead).
TOKEN_TTL_DAYS=0
# 0 = keep /docs, /redoc and /openapi.json disabled.
DGXCHAT_DOCS=0
DGXCHAT_DATA_DIR=/data
WEB_DIR=/app/web
DGXCHAT_HOST=0.0.0.0
DGXCHAT_PORT=8439

# ---------------------------------------------------------------------------
# 4. Abuse control
# ---------------------------------------------------------------------------
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_PER_HOUR=5
MESSAGE_RATE_PER_MINUTE=20
# Per-user daily quota; 0 = unlimited.
DAILY_TOKEN_QUOTA=0
DAILY_TTS_CHARS=20000

# ---------------------------------------------------------------------------
# 5. Web search
#    SEARCH_MODE=dgx        answers from your own model, retrieval via DeepSeek
#    SEARCH_MODE=official   whole turn proxied to DeepSeek (needs the key below)
#    SEARCH_MODE=off        no search tools at all
# ---------------------------------------------------------------------------
SEARCH_MODE=dgx
SEARCH_PROVIDER=deepseek
SEARCH_OFFICIAL_MODEL=deepseek-flash
SEARCH_MAX_RESULTS=6

# ---------------------------------------------------------------------------
# 6. Official DeepSeek key.
#    Optional: only used for web retrieval, TTS and ASR -- never for chat text.
#    Without it those features degrade gracefully (a header says so).
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# 7. Speech
# ---------------------------------------------------------------------------
# deepseek | openai | deepseek_tools | disabled
TTS_PROVIDER=deepseek
ASR_PROVIDER=deepseek
