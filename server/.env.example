# =============================================================================
# DGX Chat 后端配置（复制为 .env 后修改）
#
# 安全默认值：注册默认 invite-only（需要管理员发邀请码），/docs 关闭，
# CORS 不开放通配符，登录/注册限流开启，TTS 每日字符配额开启。
# 所有值都可以用环境变量覆盖；这里列出的就是全部可调项。
# =============================================================================

# ---------------------------------------------------------------------------
# 1. 部署 / 路径
# ---------------------------------------------------------------------------
# 数据目录（SQLite + 上传文件）。Docker 中固定为 /data。
DGXCHAT_DATA_DIR=/data
# 可选：单独指定数据库/文件目录（默认都在 DATA_DIR 下）
# DGXCHAT_DB_PATH=/data/dgxchat.db
# DGXCHAT_FILES_DIR=/data/files
# 内置 web 客户端目录（把前端构建产物放这里，就会在 "/" 提供；可读写挂载）
WEB_DIR=/app/web
DGXCHAT_HOST=0.0.0.0
DGXCHAT_PORT=8439

# ---------------------------------------------------------------------------
# 2. 上游推理（OpenAI 兼容网关，支持多端点 + 各自方言）
# ---------------------------------------------------------------------------
# 主端点：填你自己的 OpenAI 兼容网关（局域网最快，无鉴权）
DGX_BASE_URL=http://dgx.local:8000/v1
DGX_API_KEY=
# 备用端点（主端点连不上/5xx 时自动切换）。可以配 1~3 个：
#   DGX_BASE_URL_FALLBACK / DGX_API_KEY_FALLBACK
#   DGX_BASE_URL_FALLBACK_2 / DGX_API_KEY_FALLBACK_2
#   DGX_BASE_URL_FALLBACK_3 / DGX_API_KEY_FALLBACK_3
# 也可以用 JSON 列表一次性配置（可带每端点方言）：
#   DGX_FALLBACKS=[{"name":"public","base_url":"https://api.example.com/v1",
#                  "api_key":"sk-...","thinking_disable_mode":"reasoning_effort",
#                  "timeout":120}]
# 实测示例（NAS 部署时把上面三行取消注释并填 key）：
# DGX_BASE_URL_FALLBACK=https://api.example.com/v1
# DGX_API_KEY_FALLBACK=
# 客户端模型 id -> 上游模型 id（JSON）。两个客户端模型都映射到本地已部署模型。
DGX_MODEL_MAP={"deepseek-flash":"deepseek-v4.1-flash-official","deepseek-v4-pro":"deepseek-v4.1-flash-official"}
# 也可以单独覆盖：
# DGX_MODEL_FLASH=deepseek-v4.1-flash-official
# DGX_MODEL_PRO=deepseek-v4.1-flash-official
DGX_TIMEOUT=300
DGX_CONNECT_TIMEOUT=10
DGX_MAX_TOKENS=8192
# 留空 = 用上游默认采样参数
DGX_TEMPERATURE=
DGX_TOP_P=
# 关闭思维链的方言（实测见 README §3）：
#   reasoning_effort（默认；两个网关都接受）| thinking（仅局域网网关）|
#   both | enable_thinking | chat_template_kwargs | none
DGX_THINKING_DISABLE_MODE=reasoning_effort
# 1 = 把每次发给上游的完整请求体写进日志（用于核对系统提示词）
DGX_LOG_UPSTREAM=0
DGX_PING_INTERVAL=10
DGX_TITLE_MAX_CHARS=30
DGX_TITLE_TIMEOUT=25

# ---------------------------------------------------------------------------
# 3. 账号 / 注册 / 会话安全（P0）
# ---------------------------------------------------------------------------
# invite（默认，需要管理员发的邀请码）| closed（完全关闭）| open（任何人可注册）
# 注意：库里没有任何用户时，第一个注册者始终免邀请码并自动成为管理员。
REGISTRATION_MODE=invite
# 可选：一个固定的共享邀请码（管理员邀请码更适合日常使用）
DGXCHAT_INVITE_CODE=
DGXCHAT_PASSWORD_MIN_LENGTH=6
# Token 有效期（天）。0 = 永不过期，可随时用 /admin/users/{id}/revoke-tokens 吊销。
TOKEN_TTL_DAYS=0
# 你输出 scrypt 的 N（越大越慢越安全，2^14 约 30-60ms/次）
DGXCHAT_SCRYPT_N=16384
# /docs /redoc /openapi.json：默认关闭（404）。本地调试时设为 1。
DGXCHAT_DOCS=0

# CORS：默认只允许 Capacitor/本地浏览器；需要通配符必须显式写 *
# 留空 = 使用内置默认 https://localhost, http://localhost, capacitor://localhost,
#        ionic://localhost + 127.0.0.1/私网 LAN 正则
CORS_ALLOW_ORIGINS=
# CORS_ALLOW_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1)(?::\d+)?$
# 只有在反向代理后面才设为 1（信任 X-Forwarded-For）
DGXCHAT_TRUST_PROXY=0

# ---------------------------------------------------------------------------
# 4. 滥用限制（P1）
# ---------------------------------------------------------------------------
# 登录失败：每 (IP+用户名) 和每 IP 的窗口次数
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=300
# 允许 Authorization: Bearer <username>:<password>（SPEC §2.1 的便捷路径）。
# 该路径与 /auth/login 共用上面的失败计数器；设为 0 可强制只使用 token。
# ALLOW_CREDENTIALS_AUTH=1
# 注册：每 IP 每小时次数
REGISTER_MAX_PER_HOUR=5
# 每个用户每分钟最多 /anthropic/v1/messages 请求数
MESSAGE_RATE_PER_MINUTE=20
# 每用户每日 token 配额（0 = 不限）
DAILY_TOKEN_QUOTA=0
# 每用户每日 TTS 字符配额（0 = 不限；这是唯一真正花钱的接口）
DAILY_TTS_CHARS=20000

# ---------------------------------------------------------------------------
# 5. 请求体 / 存储上限
# ---------------------------------------------------------------------------
DGXCHAT_MAX_JSON_BYTES=8388608
DGXCHAT_MAX_UPLOAD_BYTES=104857600
DGXCHAT_MAX_IMAGE_BYTES=20971520
DGXCHAT_MAX_DOCUMENT_BYTES=8388608
# 单份文档（PDF/DOCX/文本）抽取后可进入上下文的最大字符数（默认 12 万）
# DGXCHAT_MAX_DOCUMENT_CHARS=120000
# 每用户存储配额（MiB）。0 = 不限（默认，行为与旧版本一致）。
# 超出后 /anthropic/v1/files 与 PUT /api/files/{id} 返回 413。
# USER_STORAGE_MB=0

# ---------------------------------------------------------------------------
# 6. 联网搜索 / 链接阅读（SEARCH_MODE）
# ---------------------------------------------------------------------------
# dgx（默认，正文由本地 DGX 生成，官方 key 只做检索）| official（整轮转发官方，
# 正文也由官方生成）| off（关闭）
SEARCH_MODE=dgx
# 检索来源：deepseek（官方检索接口，推荐）| brave | tavily | searxng | google_cse | none
SEARCH_PROVIDER=deepseek
# 插件检索服务的 base url 与 key（brave/tavily/searxng/google_cse 用）
SEARCH_BASE_URL=
SEARCH_API_KEY=
# 官方 Anthropic 兼容端点（检索与 official 中继用）
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic/v1
# 官方检索使用的模型 id（官方 id：deepseek-flash / deepseek-v4-pro）
SEARCH_OFFICIAL_MODEL=deepseek-flash
SEARCH_TIMEOUT=30
SEARCH_FETCH_TIMEOUT=8
SEARCH_FETCH_MAX_CHARS=8000
SEARCH_MAX_RESULTS=6
SEARCH_MAX_QUERIES=3
SEARCH_MAX_PAGES=3
# SEARCH_USER_AGENT=...

# ---------------------------------------------------------------------------
# 7. DeepSeek 官方 key（只用于联网检索 / TTS / ASR，绝不生成聊天正文）
# ---------------------------------------------------------------------------
# 本地联调时填；NAS 部署请通过部署环境注入，不要把真实 key 提交进仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# 8. TTS（语音合成）
# ---------------------------------------------------------------------------
# deepseek（官方端点，直接返回 24kHz 单声道 s16le PCM，无需转码）| openai |
# deepseek_tools（自建兼容端点）| disabled
TTS_PROVIDER=deepseek
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
# stella(default)/tide 的映射；openai 供应商默认 stella->alloy, tide->echo
# TTS_VOICE_MAP={"stella":"alloy","tide":"echo"}
TTS_TIMEOUT=120
TTS_MAX_CHARS=6000
TTS_SAMPLE_RATE=24000
TTS_CHANNELS=1
TTS_TRANSCODE_TIMEOUT=120
# 留空 = 自动在 PATH 中查找 ffmpeg（镜像内已安装）
FFMPEG_BIN=

# ---------------------------------------------------------------------------
# 9. ASR（语音识别）
# ---------------------------------------------------------------------------
# deepseek（官方 /v1/tools/asr，multipart 字段 file）| openai | deepseek_tools | disabled
ASR_PROVIDER=deepseek
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_TIMEOUT=120
ASR_MAX_BYTES=8388608
